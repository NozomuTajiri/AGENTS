# --- Server ---
PORT=3000
PUBLIC_BASE_URL=https://your-tunnel.example.com
WEBHOOK_SECRET=change-me-to-a-random-string

# --- Recall.ai ---
# https://docs.recall.ai/reference/authentication
RECALL_API_KEY=
RECALL_REGION=us-west-2
# 任意。Bot のデフォルト表示名
RECALL_BOT_NAME=カクシン AI

# --- Deepgram (Recall.ai 経由で利用) ---
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# --- LLM ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- CRM / Storage（任意。未設定ならローカル JSON に保存） ---
CRM_PROVIDER=local
HUBSPOT_TOKEN=
SALESFORCE_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_STORAGE_DIR=./data/meetings
