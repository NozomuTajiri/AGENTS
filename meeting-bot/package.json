{
  "name": "meeting-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted tl;dv alternative: Recall.ai + Deepgram + n8n + LLM chain prompts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.json",
    "schedule": "tsx scripts/scheduleBot.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
